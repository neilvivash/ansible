- name: Upgrade FOG Server
  hosts: fog_server
  become: true
  tasks:

    - name: Backup current FOG settings
      shell: tar -czf /root/fog_backup_$(date +%F).tar.gz /opt/fog /etc/apache2 /var/www/fog
      args:
        creates: "/root/fog_backup_$(date +%F).tar.gz"

    - name: Ensure required dependencies are installed
      package:
        name:
          - git
          - curl
          - wget
          - lsb-release
          - apache2
          - php
        state: present

    - name: Download latest FOG installer
      git:
        repo: "https://github.com/FOGProject/fogproject.git"
        dest: "/root/fog_latest"
        version: "dev-branch"  # Change to "master" for stable releases
        force: yes

    - name: Run the FOG installer
      shell: "cd /root/fog_latest/bin && ./installfog.sh -Y"
      args:
        chdir: "/root/fog_latest/bin"

    - name: Restart FOG services
      service:
        name: apache2
        state: restarted

    - name: Verify FOG version
      shell: "cat /opt/fog/.fogsettings | grep fogVersion"
      register: fog_version

    - name: Display new FOG version
      debug:
        msg: "FOG Server upgraded to version: {{ fog_version.stdout }}"


