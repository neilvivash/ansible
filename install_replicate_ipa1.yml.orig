---
- name: Set up FreeIPA replica on ipa1.cave.lan (replicating from ipa2.cave.lan)
  hosts: 10.10.101.236
  become: yes
  vars:
    ansible_python_interpreter: "/usr/bin/python3"  # Ensure Python 3 is used
    ipa_domain: "cave.lan"  # Replace with your domain
    ipa_realm: "CAVE.LAN"   # Replace with your Kerberos realm (uppercase)
    ipa_admin_user: "admin"
    ipa_admin_password: "while-true-do"  # Replace with the IPA admin password
    ipa_directory_manager_password: "while-true-do"  # Replace with the Directory Manager password
    ipa_master: "ipa2.cave.lan"  # The master server

  tasks:
    # 1. Install FreeIPA Server and dependencies on ipa1.cave.lan
    - name: Install FreeIPA server and dependencies
      package:
        name:
          - freeipa-server
          - freeipa-server-dns
        state: present

    # 2. Install FreeIPA replica on ipa1.cave.lan, replicating from ipa2.cave.lan
    - name: Install and configure FreeIPA replica on ipa1.cave.lan
      command: ipa-replica-install --server={{ ipa_master }} --domain={{ ipa_domain }} --unattended
      environment:
        ANSIBLE_BECOME_PASSWORD: "{{ ipa_admin_password }}"  # For sudo password

    # 3. Verify the replication status on ipa1.cave.lan
    - name: Check replication status on ipa1.cave.lan
      command: ipa-replica-manage list
      register: replica_status
      become: true

    - name: Display replication status
      debug:
        var: replica_status.stdout

    # 4. Ensure that DNS resolution works for ipa1.cave.lan
    - name: Check DNS resolution for ipa1.cave.lan
      command: dig ipa1.cave.lan @10.10.101.254
      register: dns_resolution
      become: true

    - name: Display DNS resolution result
      debug:
        var: dns_resolution.stdout

    # 5. Ensure that Apache (httpd) is running to access the Web UI
    - name: Ensure that Apache (httpd) is running on ipa1.cave.lan
      systemd:
        name: httpd
        state: started
        enabled: yes

    # 6. Open firewall ports for HTTP and HTTPS to ensure web UI access
    - name: Open firewall for HTTP and HTTPS
      firewalld:
        service: "{{ item }}"
        permanent: yes
        state: enabled
      with_items:
        - http
        - https
      become: true

    # 7. Check if IPA services are running
    - name: Check if IPA services are running on ipa1.cave.lan
      command: ipactl status
      register: ipa_services_status
      become: true

    - name: Display IPA services status
      debug:
        var: ipa_services_status.stdout

    # 8. Test replication by adding a user and verifying it is replicated
    - name: Add a test user on ipa2.cave.lan (Master)
      command: ipa user-add testuser --first=Test --last=User --password
      delegate_to: ipa2.cave.lan
      become: true

    - name: Find the test user on ipa1.cave.lan (Replica)
      command: ipa user-find testuser
      register: user_find_result
      become: true

    - name: Display user find result
      debug:
        var: user_find_result.stdout

    # 9. Test kinit (Kerberos authentication) to verify the admin login works
    - name: Test kinit with admin user on ipa1.cave.lan
      command: kinit admin
      become: true
      ignore_errors: yes

    - name: Display kinit result
      debug:
        var: result

